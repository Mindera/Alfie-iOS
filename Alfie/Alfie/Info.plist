<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Alfie uses the camera to scan the Alfie code on a product's swing tag, so it can open that product's page.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.mindera.alfie</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alfie</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<!-- A device build cannot reach the BFF at `localhost:3000` — on the phone that is the phone.
	     Pointing the Debug Menu at the Mac's LAN address needs plain HTTP to a private-range IP,
	     which ATS blocks by default. This permits local networking only; HTTP to the public
	     internet stays blocked. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
